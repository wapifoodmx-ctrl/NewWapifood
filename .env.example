# Nombres exactos que ya existen en Vercel Production (proyecto new-wapifood).
# Preview no tiene ninguna. El build no debe fallar si faltan.
# No pongas secretos reales en este archivo.

# Supabase — las que lee la app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Mercado Pago — las que lee la app
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COUNTRY=MX

# Configuradas en Production y no leídas por Next (no inventar usos):
# MERCADO_PAGO_PUBLIC_KEY  — el cobro de planes redirige a init_point; no usa el SDK en el browser
# SUPABASE_JWT_SECRET
# POSTGRES_URL
# POSTGRES_PRISMA_URL
# POSTGRES_URL_NON_POOLING
# POSTGRES_USER
# POSTGRES_HOST
# POSTGRES_PASSWORD
# POSTGRES_DATABASE
#
# La URL de retorno de Mercado Pago sale del origen de la petición
# (o de VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL, que Vercel inyecta sola).
# No hace falta NEXT_PUBLIC_SITE_URL.
